<?xml version="1.0" encoding="utf-8"?>
<!--
  Bu dosyayı "Secrets.config" adıyla kopyalayıp gerçek değerleri girin.
  Secrets.config git'e eklenmez; Web.config içindeki <appSettings file="Secrets.config"> ile okunur.
-->
<appSettings>
  <!-- En az 32 karakterlik rastgele bir değer (ör. openssl rand -base64 48) -->
  <add key="JwtSecretKey" value="" />
  <!-- Gmail adresi ve Google "Uygulama Şifresi" -->
  <add key="SmtpSenderEmail" value="" />
  <add key="SmtpSenderPassword" value="" />
</appSettings>
