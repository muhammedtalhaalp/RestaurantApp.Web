@{
    Layout = null; // Müşteriye açık sayfa: personel şablonu (kenar menü, profil) kullanılmaz
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4a154b" />
    <title>Dijital Menü</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Library/styles/qr-menu.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
</head>
<body>

    <!-- KARŞILAMA: restoran adı ve masa -->
    <header class="menu-hero">
        <div class="menu-hero-inner">
            <div class="hero-badge"><i class="fa-solid fa-utensils"></i></div>
            <p class="hero-eyebrow">Dijital Menü</p>
            <h1 class="hero-title" id="restaurantName">Menü yükleniyor…</h1>
            <span class="hero-table d-none" id="tableBadge"><i class="fa-solid fa-chair me-1"></i><span id="tableName"></span></span>
        </div>
    </header>

    <!-- YAPIŞKAN ÇUBUK: arama ve kategoriler -->
    <nav class="menu-toolbar" id="menuToolbar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="menuSearch" placeholder="Menüde ara…" autocomplete="off" enterkeyhint="search" />
            <button type="button" class="search-clear d-none" id="searchClear" aria-label="Aramayı temizle">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="category-chips" id="categoryChips"></div>
    </nav>

    <main class="menu-main">
        <!-- Yükleniyor iskeleti -->
        <div id="menuSkeleton">
            <div class="skeleton skeleton-title"></div>
            <div class="skeleton skeleton-row"></div>
            <div class="skeleton skeleton-row"></div>
            <div class="skeleton skeleton-row"></div>
        </div>

        <!-- En çok tercih edilenler -->
        <section class="popular-section d-none" id="popularSection">
            <h2 class="section-title"><i class="fa-solid fa-fire-flame-curved"></i>En Çok Tercih Edilenler</h2>
            <div class="popular-scroll" id="popularContainer"></div>
        </section>

        <!-- Kategori bölümleri -->
        <div id="categorySections"></div>

        <!-- Arama sonucu yok / hata -->
        <div class="menu-empty d-none" id="menuEmpty">
            <i class="fa-solid fa-bowl-food"></i>
            <p id="menuEmptyText">Aradığınız ürün bulunamadı.</p>
        </div>
    </main>

    <footer class="menu-footer">
        <span>Afiyet olsun!</span>
        <small>LezzetPOS dijital menü</small>
    </footer>

    <!-- ÜRÜN DETAYI (alttan açılan pencere) -->
    <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered product-dialog">
            <div class="modal-content product-sheet">
                <button type="button" class="sheet-close" data-bs-dismiss="modal" aria-label="Kapat"><i class="fa-solid fa-xmark"></i></button>
                <div class="sheet-image"><img id="sheetImage" src="" alt="" /></div>
                <div class="sheet-body">
                    <span class="sheet-category" id="sheetCategory"></span>
                    <h3 class="sheet-title" id="sheetTitle"></h3>
                    <p class="sheet-desc" id="sheetDesc"></p>
                    <div class="sheet-footer">
                        <span class="sheet-price" id="sheetPrice"></span>
                        <span class="sold-out d-none" id="sheetSoldOut"><i class="fa-solid fa-ban me-1"></i>Tükendi</span>
                    </div>
                    <p class="sheet-hint"><i class="fa-regular fa-hand-pointer me-1"></i>Sipariş vermek için garsonunuzu çağırabilirsiniz.</p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Library/scripts/qr-menu.js?v=@DateTime.Now.Ticks"></script>
</body>
</html>
