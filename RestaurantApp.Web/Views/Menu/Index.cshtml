@{
    Layout = null; // Kendi özel mobil şablonunu kullanacağı için Layout kullanmıyoruz
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>LezzetPOS - Dijital QR Menü</title>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- QR Menü CSS -->
    <link href="~/Library/styles/qr-menu.css?v=1.0" rel="stylesheet" />
</head>
<body>

    <!-- Üst Header Bar -->
    <header class="qr-header d-flex justify-content-between align-items-center px-3 py-2 sticky-top">
        <div class="brand-logo-wrap d-flex align-items-center gap-2">
            <i class="fa-solid fa-utensils fs-4 text-white"></i>
            <span class="fw-bold fs-5 text-white tracking-wide">LEZZET POS</span>
        </div>
        <div>
            <a href="javascript:void(0);" onclick="location.reload();" class="text-white fs-5 me-2">
                <i class="fa-solid fa-rotate-right"></i>
            </a>
        </div>
    </header>

    <!-- Ana Konteyner -->
    <div class="qr-container pb-5">

        <!-- 1. ÜST BANNER SLIDER -->
        <div id="heroCarousel" class="carousel slide carousel-fade mb-4" data-bs-ride="carousel" data-bs-interval="3500">
            <div class="carousel-inner rounded-bottom-4 shadow-sm" id="sliderContainer">
                <!-- JS ile Doldurulacak -->
                <div class="carousel-item active">
                    <img src="/Content/images/default-food.png" class="d-block w-100 slider-img" alt="LezzetPOS">
                </div>
            </div>
        </div>

        <!-- 2. EN ÇOK TERCİH EDİLENLER (YATAY KAYDIRILABİLİR) -->
        <div class="px-3 mb-4">
            <h6 class="section-title fw-bold text-dark mb-3 text-center">
                <i class="fa-solid fa-fire text-danger me-1"></i>En Çok Tercih Edilenler
            </h6>
            <div class="popular-scroll-wrap d-flex gap-3 overflow-x-auto pb-2" id="popularContainer">
                <!-- JS ile Doldurulacak -->
            </div>
        </div>

        <!-- 3. KATEGORİLER (2'Lİ GRID KARTLAR) -->
        <div class="px-3 mb-4">
            <h6 class="section-title fw-bold text-dark mb-3 text-center">
                <i class="fa-solid fa-list me-1" style="color: #4a154b;"></i>Kategoriler
            </h6>
            <div class="row g-3" id="categoriesContainer">
                <!-- JS ile Doldurulacak -->
            </div>
        </div>

    </div>

    <!-- KATEGORİ ÜRÜNLERİ MODAL (Kategoriye Tıklanınca Açılır) -->
    <div class="modal fade" id="categoryProductsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content border-0 rounded-top-4">
                <div class="modal-header border-bottom py-3 px-3">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center" id="modalCategoryTitle">
                        <i class="fa-solid fa-utensils me-2" style="color: #4a154b;"></i>Kategori Ürünleri
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3 bg-light" id="categoryProductsList">
                    <!-- JS ile Doldurulacak -->
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Library/scripts/qr-menu.js?v=1.0"></script>
</body>
</html>