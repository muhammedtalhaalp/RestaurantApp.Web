@{
    ViewBag.Title = "Mutfak Ekranı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/kitchen.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="container-fluid px-3 py-2 h-100 d-flex flex-column">
    <!-- ÜST BAŞLIK BAR -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-fire-burner me-2 style-purple-icon"></i>Mutfak Sipariş Ekranı
            </h4>
            <p class="text-muted small mb-0">Siparişleri takip edebilir, karta tıklayarak ürün bazlı hazırlık yapabilirsiniz.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Hijyen Kamerası İhlal Geçmişi Butonu (rozet: bugünkü çözülmemiş ihlal sayısı) -->
            <button class="btn btn-outline-warning text-dark btn-sm rounded-3 px-3 h-38 fw-semibold position-relative" type="button" onclick="openHygieneViolationsModal()">
                <i class="fa-solid fa-shield-virus me-1"></i> Hijyen İhlalleri
                <span id="hygieneUnresolvedBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
            </button>

            <!-- 86 List / Stok Durumu Butonu -->
            <button class="btn btn-outline-danger btn-sm rounded-3 px-3 h-38 fw-semibold" type="button" onclick="openKitchenStockModal()">
                <i class="fa-solid fa-ban me-1"></i> Tükendi / Stok (86)
            </button>

            <!-- Bildirim Sesi Dropdown Menüsü -->
            <div class="dropdown">
                <button class="btn btn-outline-purple btn-sm rounded-3 px-3 dropdown-toggle d-flex align-items-center gap-2 h-38" type="button" id="dropdownKitchenSound" data-bs-toggle="dropdown" aria-expanded="false">
                    <span>Bildirim Sesi</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-1" aria-labelledby="dropdownKitchenSound">
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectKitchenSound('chime', true)">Zil (Klasik)</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectKitchenSound('double-beep', true)">Çift Bip (Eko)</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectKitchenSound('melody', true)">Melodik (Üçlü)</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectKitchenSound('alarm', true)">Yüksek Alarm</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectKitchenSound('whistle', true)">Mutfak Düdüğü</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectKitchenSound('digital', true)">Dijital Bip</a></li>
                </ul>
            </div>

            <button class="btn btn-outline-purple btn-sm rounded-3 px-3 h-38 fw-semibold" onclick="loadKitchenOrders()">
                <i class="fa-solid fa-rotate me-1"></i> Yenile
            </button>
        </div>
    </div>

    <!-- Sipariş Kartları Izgarası -->
    <div class="row g-3 flex-grow-1 align-content-start" id="kitchen-orders-grid">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-purple-main" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="text-muted mt-2">Siparişler yükleniyor...</p>
        </div>
    </div>
</div>

<!-- 1. SİPARİŞ DETAY MODALI -->
<div class="modal fade" id="modalKitchenOrderDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom p-3 kitchen-modal-header" id="modalKitchenHeader">
                <h5 class="modal-title fw-bold text-white mb-0 d-flex align-items-center" id="modalKitchenTitle">
                    <i class="fa-solid fa-utensils me-2"></i>Sipariş Detayı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="modalKitchenSubInfo" class="mb-2"></div>
                <div id="modalKitchenNoteBox"></div>

                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Ürün Listesi</h6>
                <ul class="list-group list-group-flush modal-items-scroll-list" id="modalKitchenItemsList">
                    <!-- JS Dolduracak -->
                </ul>
            </div>
            <div class="modal-footer p-2 bg-light border-top d-flex gap-2" id="modalKitchenFooterAction">
                <!-- JS Butonları Buraya Basacak -->
            </div>
        </div>
    </div>
</div>

<!-- 2. TÜKENDİ / 86 LIST (STOK KONTROL) MODALI -->
<div class="modal fade" id="modalKitchenStock" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom p-3 bg-danger text-white d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold mb-0 d-flex align-items-center">
                    <i class="fa-solid fa-ban me-2"></i>Mutfak Stok & Tükendi Listesi (86 List)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <p class="text-muted small mb-3">
                    Stoğu biten ürünleri buradan <b>"Tükendi"</b> durumuna getirebilirsiniz. Tükendi olan ürünler garson POS ekranında anında siparişe kapatılır.
                </p>
                <div class="input-group mb-3 shadow-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="txtKitchenSearchStock" class="form-control border-start-0" placeholder="Ürün adı ile ara..." onkeyup="filterKitchenStockList()" />
                </div>
                <div class="table-responsive rounded-3 border" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 50px;">Görsel</th>
                                <th>Ürün Adı</th>
                                <th>Kategori</th>
                                <th class="text-center" style="width: 140px;">Durum</th>
                                <th class="text-center" style="width: 120px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="kitchenStockTableBody">
                            <!-- JS Dolduracak -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer p-2 bg-light border-top d-flex justify-content-end">
                <button type="button" class="btn btn-secondary px-4 fw-semibold rounded-3 btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- 3. HİJYEN İHLALLERİ GEÇMİŞİ MODALI -->
<div class="modal fade" id="modalHygieneViolations" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom p-3 bg-warning d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold mb-0 d-flex align-items-center text-dark">
                    <i class="fa-solid fa-shield-virus me-2"></i>Hijyen Kamerası İhlalleri
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="btn-group btn-group-sm" role="group" id="hygieneRangeButtons">
                        <button type="button" class="btn btn-outline-dark active" data-range="today" onclick="selectHygieneRange('today', this)">Bugün</button>
                        <button type="button" class="btn btn-outline-dark" data-range="week" onclick="selectHygieneRange('week', this)">Son 7 Gün</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted" id="hygieneSummaryText"></span>
                        <button type="button" class="btn btn-sm btn-danger fw-semibold rounded-3 hygiene-delete-only" id="btnDeleteSelectedViolations" onclick="deleteSelectedHygieneViolations()" disabled>
                            <i class="fa-solid fa-trash-can me-1"></i>Seçilenleri Sil (<span id="hygieneSelectedCount">0</span>)
                        </button>
                    </div>
                </div>
                <div class="table-responsive rounded-3 border" style="max-height: 420px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="hygiene-delete-only" style="width: 40px;">
                                    <input type="checkbox" class="form-check-input hygiene-check" id="chkSelectAllViolations" title="Tümünü seç" onchange="toggleAllHygieneViolations(this.checked)">
                                </th>
                                <th style="width: 110px;">Fotoğraf</th>
                                <th style="width: 130px;">Zaman</th>
                                <th>İhlal</th>
                                <th class="text-center" style="width: 150px;">Durum</th>
                            </tr>
                        </thead>
                        <tbody id="hygieneViolationsTableBody">
                            <!-- JS Dolduracak -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer p-2 bg-light border-top d-flex justify-content-end">
                <button type="button" class="btn btn-secondary px-4 fw-semibold rounded-3 btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @{
        string kitchenUserRole = Session["UserRole"] as string ?? "";
    }
    <script>
        // İhlal kayıtlarını yalnızca Admin ve Mutfak Şefi silebilir (sunucu da AiVision/DeleteViolations'da kontrol eder)
        window.canDeleteHygieneViolations = @((kitchenUserRole == "Admin" || kitchenUserRole == "Mutfak Şefi") ? "true" : "false");
    </script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/Library/scripts/kitchen.js?v=@DateTime.Now.Ticks"></script>
}