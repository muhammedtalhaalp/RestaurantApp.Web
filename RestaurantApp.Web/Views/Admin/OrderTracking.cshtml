@{
    ViewBag.Title = "Sipariş Takip";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/order-tracking.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="container-fluid mt-2">
    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-clock-rotate-left me-2" style="color: #4a154b;"></i>Sipariş Takip
            </h4>
            <p class="text-muted small mb-0">Mutfaktan çıkan ve teslimat bekleyen ürünleri buradan canlı takip edebilir, hazır olanları teslim alabilirsiniz.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-purple-main fs-6 px-3 py-2 rounded-pill" id="pendingOrdersCountBadge">0 Sipariş Bekliyor</span>
        </div>
    </div>

    <!-- Canlı Takip Kartları Alanı -->
    <div class="card card-clean border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="row g-3" id="adminPendingOrdersContainer">
                <div class="col-12 text-center py-5 text-muted">
                    <i class="fa-solid fa-spinner fa-spin fs-3 mb-3 d-block" style="color: #4a154b;"></i>
                    <span>Siparişler yükleniyor...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SİPARİŞ DETAY VE ÜRÜN İÇERİĞİ MODALI -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header border-bottom py-3 px-4" style="background-color: #4a154b; color: #ffffff;">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center mb-0" id="modalOrderTitle">
                    <i class="fa-solid fa-receipt me-2"></i>Sipariş Detayı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3 border">
                    <div>
                        <span class="text-muted small d-block">Sipariş Saati:</span>
                        <strong id="lblOrderTime" class="text-dark">--:--</strong>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Genel Durum:</span>
                        <span id="lblOrderStatusBadge" class="badge bg-secondary">--</span>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-utensils me-2" style="color: #4a154b;"></i>Sipariş Edilen Ürünler ve Hazırlık Durumu</h6>
                <div class="table-responsive border rounded-3 overflow-hidden mb-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="py-2 px-3 small text-muted">Ürün Adı</th>
                                <th class="py-2 px-3 small text-muted text-center">Adet</th>
                                <th class="py-2 px-3 small text-muted text-center">Durum</th>
                                <th class="py-2 px-3 small text-muted text-end">Fiyat</th>
                                <th class="py-2 px-3 small text-muted text-end">Toplam</th>
                                <th class="py-2 px-3 small text-muted text-center" style="width: 60px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="tblOrderItemsBody">
                            <!-- JS Tarafından Doldurulacak -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <span class="fw-bold text-dark fs-6">Adisyon Toplamı:</span>
                    <span id="lblOrderTotalAmount" class="fw-bold fs-5 text-purple-main">0.00 ₺</span>
                </div>
            </div>
            <div class="modal-footer border-top p-3 bg-light d-flex justify-content-end gap-2" id="modalFooterActions">
                <!-- Teslim Aldım / Kapat Butonları JS İle Eklenecek -->
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/Library/scripts/order-tracking.js?v=@DateTime.Now.Ticks"></script>
}