@model IEnumerable<RestaurantApp.Web.Data.AppTables>
@{
    ViewBag.Title = "Masa Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/table-management.css" rel="stylesheet" />
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0"><i class="fa-solid fa-chair me-2 table-management-title"></i>Masa Yönetimi</h3>
            <p class="text-muted small m-0">Restoran masalarını ekleyin, listeleyin veya sistemden kaldırın.</p>
        </div>
        <button class="btn btn-theme-primary fw-bold px-4 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTableModal">
            <i class="fa-solid fa-plus me-2"></i>Yeni Masa Ekle
        </button>
    </div>

    <!-- Masa Listesi Tablosu -->
    <div class="card border-0 shadow-sm table-management-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Masa ID</th>
                            <th>Masa Adı / No</th>
                            <th>Masa Durumu</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var table in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@table.TableId</td>
                                    <td class="fw-bold text-dark">Masa @table.TableNumber</td>
                                    <td>
                                        @if (table.Status == "Bos")
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Boş</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">Dolu / Rezerve</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-outline-danger btn-sm rounded-3 px-3 btn-delete-table" data-id="@table.TableId">
                                            <i class="fa-solid fa-trash me-1"></i>Sil
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Kayıtlı masa bulunmamaktadır. Lütfen yeni masa ekleyin.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Masa Ekleme Modalı -->
<div class="modal fade" id="addTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2 table-management-title"></i>Yeni Masa Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Masa Numarası / Adı:</label>
                    <input type="text" id="txtTableNumber" class="form-control rounded-3" placeholder="Örn: 1, 2 veya Bahçe-1" />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="btnSaveTable" class="btn btn-theme-primary rounded-3 fw-bold px-4">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/table-management.js"></script>
}