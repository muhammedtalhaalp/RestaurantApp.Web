@model IEnumerable<RestaurantApp.Web.Data.AppTables>
@{
    ViewBag.Title = "Masa Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/table-management.css" rel="stylesheet" />
}

<div class="container-fluid py-3">
    <!-- Üst Başlık & Butonlar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0"><i class="fa-solid fa-chair me-2 table-management-title"></i>Masa Yönetimi</h3>
            <p class="text-muted small m-0">Restoran alanlarına göre masalarınızı yönetin, yeni masa ekleyin veya düzenleyin.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary fw-bold rounded-3 shadow-sm" id="btnOpenManageSectionsModal" data-bs-toggle="modal" data-bs-target="#manageSectionsModal">
                <i class="fa-solid fa-layer-group me-2"></i>Alanları Yönet
            </button>
            <a href="/Admin/FloorPlanManagement" class="btn btn-outline-purple fw-bold rounded-3 shadow-sm">
                <i class="fa-solid fa-map-location-dot me-2"></i>Kroki Yönetimi
            </a>
            <button class="btn btn-theme-primary fw-bold px-4 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTableModal">
                <i class="fa-solid fa-plus me-2"></i>Yeni Masa Ekle
            </button>
        </div>
    </div>

    <!-- Alan / Bölüm Sekmeleri (Dinamik JS Tarafından Doldurulacak) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-2">
            <ul class="nav nav-pills nav-fill gap-2" id="sectionTabs">
                <li class="nav-item">
                    <button class="nav-link active fw-bold py-2 rounded-3" data-section="Hepsi">Tümü</button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Masa Kartları Grid Alanı -->
    <div class="row g-3" id="tableCardContainer">
        <!-- JS tarafı masaları buraya çizecek -->
    </div>
</div>

<!-- Yeni Masa Ekleme Modalı -->
<div class="modal fade" id="addTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2 table-management-title"></i>Yeni Masa Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Masa Adı / Numarası:</label>
                    <input type="text" id="txtTableNumber" class="form-control rounded-3" placeholder="Örn: Masa 5, B01, Bodrum-1" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Restoran Alanı:</label>
                    <select id="selectSection" class="form-select rounded-3">
                        <!-- Dinamik Alanlar JS Tarafından Doldurulacak -->
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="btnSaveTable" class="btn btn-theme-primary rounded-3 fw-bold px-4">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Alan Yönetimi (Ekle & Sil) Modalı -->
<div class="modal fade" id="manageSectionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-layer-group me-2 table-management-title"></i>Restoran Alan Yönetimi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <!-- Yeni Alan Ekleme Formu -->
                <label class="form-label fw-semibold mb-2">Yeni Alan Ekle:</label>
                <div class="input-group mb-4">
                    <input type="text" id="txtNewSectionName" class="form-control rounded-start-3" placeholder="Örn: Bodrum Kat, VIP Salon..." />
                    <button type="button" id="btnAddSectionCustom" class="btn btn-theme-primary rounded-end-3 px-3 fw-bold">
                        <i class="fa-solid fa-plus me-1"></i>Ekle
                    </button>
                </div>

                <hr class="opacity-10 my-3" />

                <!-- Mevcut Alanlar Listesi -->
                <label class="form-label fw-semibold mb-2">Mevcut Alanlar:</label>
                <ul class="list-group list-group-flush rounded-3 border overflow-hidden" id="sectionListContainer" style="max-height: 220px; overflow-y: auto;">
                    <!-- JS Tarafından Doldurulacak -->
                </ul>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 fw-bold px-4" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/table-management.js?v=1.3"></script>
}