@model IEnumerable<RestaurantApp.Web.Data.AppTables>
@{
    ViewBag.Title = "Masa Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/table-management.css" rel="stylesheet" />
}

<div class="container-fluid py-3">
    <!-- Üst Başlık & Butonlar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0"><i class="fa-solid fa-chair me-2 table-management-title"></i>Masa Yönetimi</h3>
            <p class="text-muted small m-0">Restoran alanlarına göre masalarınızı yönetin, yeni masa ekleyin veya düzenleyin.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/FloorPlanManagement" class="btn btn-outline-purple fw-bold rounded-3 shadow-sm">
                <i class="fa-solid fa-map-location-dot me-2"></i>Kroki Yönetimi
            </a>
            <button class="btn btn-theme-primary fw-bold px-4 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTableModal">
                <i class="fa-solid fa-plus me-2"></i>Yeni Masa Ekle
            </button>
        </div>
    </div>

    <!-- Alan / Bölüm Sekmeleri (Tabs) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-2">
            <ul class="nav nav-pills nav-fill gap-2" id="sectionTabs">
                <li class="nav-item">
                    <button class="nav-link active fw-bold py-2 rounded-3" data-section="Hepsi">Tümü</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold py-2 rounded-3" data-section="Salon">Salon</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold py-2 rounded-3" data-section="Bahçe">Bahçe</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold py-2 rounded-3" data-section="Balkon">Balkon</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold py-2 rounded-3" data-section="Teras">Teras</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold py-2 rounded-3" data-section="Üst Kat">Üst Kat</button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Masa Kartları Grid Alanı -->
    <div class="row g-3" id="tableCardContainer">
        <!-- JS tarafı masaları buraya kart olarak çizecek -->
    </div>
</div>

<!-- Yeni Masa Ekleme Modalı -->
<div class="modal fade" id="addTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2 table-management-title"></i>Yeni Masa Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Masa Adı / Numarası:</label>
                    <input type="text" id="txtTableNumber" class="form-control rounded-3" placeholder="Örn: B00201, Masa 5" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Restoran Alanı:</label>
                    <select id="selectSection" class="form-select rounded-3">
                        <option value="Salon">Salon</option>
                        <option value="Bahçe">Bahçe</option>
                        <option value="Balkon">Balkon</option>
                        <option value="Teras">Teras</option>
                        <option value="Üst Kat">Üst Kat</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="btnSaveTable" class="btn btn-theme-primary rounded-3 fw-bold px-4">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/table-management.js"></script>
}