@{
    ViewBag.Title = "Admin Paneli - Menü Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/dashboard.css?v=2.1" rel="stylesheet" />
}

<div class="container-fluid mt-2">
    <!-- Sayfa Başlığı ve Üst Butonlar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-sliders me-2" style="color: #4a154b;"></i>Kontrol Paneli
            </h4>
            <p class="text-muted small mb-0">Restoran kategorilerini ve ürünlerini tek bir ekrandan yönetin.</p>
        </div>
        <div class="d-flex gap-2">
            <!-- Kar ikonu kaldırıldı, tüm butonlar mor çizgiye çekildi -->
            <button type="button" class="btn btn-outline-purple btn-top-action rounded-3 fw-bold shadow-sm" onclick="openCategoryManagementModal()">
                Kategori Pasife Al
            </button>
            <button type="button" class="btn btn-outline-purple btn-top-action rounded-3 fw-bold shadow-sm" onclick="openAddCategoryModal()">
                <i class="fa-solid fa-folder-plus me-1"></i>Kategori Ekle
            </button>
            <button type="button" class="btn btn-purple btn-top-action rounded-3 fw-bold shadow-sm px-3" onclick="openAddProductModal()">
                <i class="fa-solid fa-plus me-1"></i>Ürün Ekle
            </button>
        </div>
    </div>

    <!-- Mevcut Menü Listesi Kartı -->
    <div class="card card-clean border-0 shadow-sm rounded-4">
        <div class="card-header-clean d-flex justify-content-between align-items-center">
            <span><i class="fa-solid fa-utensils me-2" style="color: #4a154b;"></i>Restoran Menüsü</span>
            <button class="btn btn-sm btn-outline-secondary px-3 rounded-2" onclick="loadProducts()">
                <i class="fa-solid fa-rotate me-1"></i>Yenile
            </button>
        </div>

        <!-- DETAYLI FİLTRELEME ÇUBUĞU -->
        <div class="p-3 border-bottom bg-light">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="filterSearch" class="form-control border-start-0 input-clean" placeholder="Ürün adı veya açıklama ara...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="filterCategory" class="form-select form-select-sm input-clean">
                        <option value="">Tüm Kategoriler</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="filterStatus" class="form-select form-select-sm input-clean">
                        <option value="">Tüm Stok Durumları</option>
                        <option value="available">Stokta Var</option>
                        <option value="out">Tükendi</option>
                    </select>
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger w-100" id="btnClearFilters" title="Filtreleri Temizle">
                        <i class="fa-solid fa-filter-circle-xmark"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- TABLO ALANI -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-clean table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Görsel</th>
                            <th>Ürün Adı</th>
                            <th>Kategori</th>
                            <th>Fiyat</th>
                            <th>Durum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="tblProductList">
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Menüde henüz ürün yok.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- KATEGORİ EKLEME MODALI -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom p-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-folder-plus me-2" style="color: #4a154b;"></i>Yeni Kategori Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="form-group mb-3">
                    <label class="fw-semibold text-secondary mb-1 small">Kategori Adı</label>
                    <input type="text" id="txtCategoryNameModal" class="form-control input-clean" placeholder="Örn: Tatlılar, İçecekler">
                </div>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-purple px-4" onclick="addCategoryFromModal()">
                    <i class="fa-solid fa-plus me-1"></i>Kategori Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ÜRÜN EKLEME MODALI -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom p-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-square-plus me-2" style="color: #4a154b;"></i>Menüye Yeni Ürün Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="productForm">
                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Ürün Adı</label>
                        <input type="text" id="txtProductName" class="form-control input-clean" placeholder="Örn: Izgara Köfte" required>
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Kategori</label>
                        <select id="ddlCategories" class="form-select input-clean" required>
                            <option value="">-- Kategori Seçin --</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Fiyat (₺)</label>
                        <input type="number" step="0.01" id="txtPrice" class="form-control input-clean" placeholder="0.00" required>
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Açıklama</label>
                        <textarea id="txtDescription" class="form-control input-clean" rows="2" placeholder="Ürün açıklaması..."></textarea>
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Ürün Görseli Seç</label>
                        <input type="file" id="fileImage" class="form-control input-clean" accept="image/*">
                    </div>
                    <div class="mb-3 text-center d-none" id="imgPreviewWrapper">
                        <img id="imgPreview" src="#" alt="Görsel Önizleme" class="img-thumbnail rounded-3" style="max-height: 120px; object-fit: cover;">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-purple px-4" id="btnAddProductBtn" onclick="addProduct()">
                    <i class="fa-solid fa-check me-1"></i>Ürünü Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ÜRÜN DÜZENLEME MODALI -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom p-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-pen-to-square me-2" style="color: #4a154b;"></i>Ürün Bilgilerini Düzenle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editProductForm">
                    <input type="hidden" id="editProductId" />
                    <input type="hidden" id="editExistingImageUrl" />

                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Ürün Adı</label>
                        <input type="text" id="editProductName" class="form-control input-clean" required />
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Kategori</label>
                        <select id="editDdlCategories" class="form-select input-clean" required>
                            <option value="">-- Kategori Seçin --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Fiyat (₺)</label>
                        <input type="number" step="0.01" id="editPrice" class="form-control input-clean" required />
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Açıklama</label>
                        <textarea id="editDescription" class="form-control input-clean" rows="2"></textarea>
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-semibold text-secondary mb-1 small">Yeni Görsel Seç (İsteğe Bağlı)</label>
                        <input type="file" id="editFileImage" class="form-control input-clean" accept="image/*" />
                    </div>

                    <div class="mb-3 text-center" id="editImgPreviewWrapper">
                        <img id="editImgPreview" src="#" alt="Önizleme" class="img-thumbnail rounded-3" style="max-height: 120px; object-fit: cover;" />
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-purple px-4" id="btnUpdateProductBtn" onclick="updateProduct()">
                    <i class="fa-solid fa-check me-1"></i>Değişiklikleri Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- KATEGORİ PASİFE AL / YÖNETİM MODALI -->
<div class="modal fade" id="categoryManagementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom p-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-layer-group me-2" style="color: #4a154b;"></i>Kategori Pasife Al 
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <p class="text-muted small mb-3">Pasife alınan kategorideki ürünler menü tablosunda soluk renkle görünür ve sipariş/POS ekranında seçilemez.</p>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kategori Adı</th>
                                <th>Durum</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="tblCategoryManagementList">
                            <!-- JS ile Doldurulacak -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/dashboard.js?v=2.1"></script>
}