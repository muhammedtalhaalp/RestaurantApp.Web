@{
    ViewBag.Title = "Ana Sayfa - LezzetPOS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/admin-index.css" rel="stylesheet" />
}

<div class="container-fluid mt-2">
    <div class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="background: #ffffff;">
        <div class="d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle" style="background: #f3ecf8; color: #4a154b;">
                <i class="fa-solid fa-house fa-2x"></i>
            </div>
            <div>
                <h4 class="fw-bold text-dark mb-1">Hoş Geldiniz!</h4>
                <p class="text-muted small mb-0">LezzetPOS yönetim paneline hoş geldiniz. Sol menüden veya aşağıdaki kartlardan işlemlerinizi gerçekleştirebilirsiniz.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Kontrol Paneli Kartı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Admin/Dashboard" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <h5 class="menu-card-title">Kontrol Paneli</h5>
                <p class="menu-card-desc">
                    Günlük satış istatistiklerini, popüler ürünleri ve anlık ciro raporlarını grafiklerle inceleyin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Ciro ve Grafikler Kartı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Admin/FinancialReports" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <h5 class="menu-card-title">Ciro ve Grafikler</h5>
                <p class="menu-card-desc">
                    Günlük, haftalık, aylık ciro analizlerini, ödeme türü dağılımlarını ve en çok satan ürünleri inceleyin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Personel Yönetimi Kartı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Admin/StaffManagement" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
                <h5 class="menu-card-title">Personel Yönetimi</h5>
                <p class="menu-card-desc">
                    Mutfak şefi, garson ve kasiyer hesaplarını ekleyin, yetkilerini ve aktiflik durumlarını yönetin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Sipariş Takip Kartı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Admin/OrderTracking" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <h5 class="menu-card-title">Sipariş Takip</h5>
                <p class="menu-card-desc">
                    Mutfaktan çıkan ve garson teslimatı bekleyen hazır sipariş durumlarını anlık izleyin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Mutfak Raporu Kartı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Admin/KitchenReport" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <h5 class="menu-card-title">Mutfak Raporu</h5>
                <p class="menu-card-desc">
                    Günlük mutfak siparişlerini, ürün detaylarını, saatlik akışı ve ciro raporlarını inceleyin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Mutfak Performansı Kartı (YENİ) -->
        <div class="col-md-6 col-lg-4">
            <a href="/Kitchen/Performance" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <h5 class="menu-card-title">Mutfak Performansı</h5>
                <p class="menu-card-desc">
                    Ortalama sipariş çıkarma sürelerini, SLA başarı oranlarını ve saatlik mutfak yoğunluklarını analiz edin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Ürün Reçeteleri Kartı (YENİ) -->
        <div class="col-md-6 col-lg-4">
            <a href="/Kitchen/Recipes" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <h5 class="menu-card-title">Ürün Reçeteleri</h5>
                <p class="menu-card-desc">
                    Şef reçetelerini, porsiyon gramajlarını, pişirme sürelerini ve adım adım hazırlık SOP kurallarını yönetin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Masa Yönetimi Kartı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Admin/TableManagement" class="menu-card">
                <div class="menu-card-icon">
                    <i class="fa-solid fa-chair"></i>
                </div>
                <h5 class="menu-card-title">Masa Yönetimi</h5>
                <p class="menu-card-desc">
                    Restoran masalarını ekleyin, yetkisiz erişimleri engelleyin, aktif/pasif durumlarını yönetin.
                </p>
                <div class="menu-card-arrow">
                    <span>Sayfaya Git</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/adminIndex.js"></script>
}