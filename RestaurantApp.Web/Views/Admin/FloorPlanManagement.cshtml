@{
    ViewBag.Title = "Kroki Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/floor-plan.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/Library/styles/floor-plan-management.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="floor-editor">
    <!-- ÜST BAŞLIK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-map-location-dot me-2 text-brand"></i>Kroki Yönetimi
            </h4>
            <p class="text-muted small mb-0">Her kat / alan için binanın şeklini çizin, masaları ve diğer öğeleri yerleştirin; bitince yayınlayın. Kasada yalnızca yayınlanan kroki kullanılır.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="save-status" id="saveStatus"><i class="fa-solid fa-circle-check me-1"></i>Kaydedildi</span>
            <a href="/Admin/TableManagement" class="btn btn-outline-secondary btn-sm px-3">
                <i class="fa-solid fa-arrow-left me-1"></i>Masa Yönetimi
            </a>
        </div>
    </div>

    <!-- ALANLAR -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <ul class="nav nav-pills gap-2" id="sectionTabs"></ul>
        <button type="button" class="btn btn-outline-brand btn-sm" id="btnAddSection">
            <i class="fa-solid fa-plus me-1"></i>Yeni Alan / Kat
        </button>
    </div>

    <!-- ÖĞE PALETİ: krokiye daha çok yer kalsın diye üstte yatay şerit -->
    <div class="card p-3 mb-3">
        <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
            <div class="panel-title mb-0"><i class="fa-solid fa-shapes me-2"></i>Öğe Ekle</div>
            <span class="text-muted small">Tıklayın; öğe krokinin ortasına eklenir.</span>
        </div>
        <div class="palette" id="palette"></div>
    </div>

    <div class="row g-3">
        <!-- KROKİ -->
        <div class="col-xl-9 col-lg-8">
            <div class="card p-3">
                <div id="publishBar" class="publish-bar mb-3"></div>
                <div id="floorCanvas"></div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 small text-muted">
                    <span><i class="fa-solid fa-hand-pointer me-1"></i>Sürükleyerek taşıyın · sağ alt köşeden boyutlandırın · <kbd>Del</kbd> ile silin · ok tuşlarıyla kaydırın</span>
                    <span class="legend"><span class="dot empty"></span>Boş masa <span class="dot occupied ms-2"></span>Dolu masa</span>
                </div>
            </div>
        </div>

        <!-- ÖZELLİKLER -->
        <div class="col-xl-3 col-lg-4">
            <div class="card p-3 h-100" id="inspector"></div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/floor-plan-view.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/Library/scripts/floor-plan-management.js?v=@DateTime.Now.Ticks"></script>
}
