@model IEnumerable<RestaurantApp.Web.Data.AppTables>
@{
    ViewBag.Title = "Kroki Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/floor-plan-management.css" rel="stylesheet" />
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0"><i class="fa-solid fa-map-location-dot me-2" style="color: #4a154b;"></i>Kroki Yönetimi</h3>
            <p class="text-muted small m-0">Restoran mimari çizimini sürükleyip boyutlandırarak tasarlayın.</p>
        </div>
        <div>
            <a href="/Admin/TableManagement" class="btn btn-outline-secondary fw-bold rounded-3 shadow-sm">
                <i class="fa-solid fa-arrow-left me-2"></i>Masa Yönetimine Dön
            </a>
        </div>
    </div>

    <!-- KROKİ / MİMARİ YERLEŞİM ALANI -->
    <div id="floorPlanContainer" class="card border-0 shadow-sm p-3 rounded-4 mb-4">
        <div class="floor-plan-container" id="floorPlanCanvas">
            <!-- Sabit/Sürüklenebilir Mimari Unsurlar -->
            <div class="architect-element elem-kitchen" id="elem-kitchen"><i class="fa-solid fa-utensils me-2"></i>Mutfak</div>
            <div class="architect-element elem-pos" id="elem-pos"><i class="fa-solid fa-cash-register me-2"></i>Kasa</div>
            <div class="architect-element elem-door-inner" id="elem-door-inner"><i class="fa-solid fa-door-open me-1"></i>İç Kapı</div>
            <div class="architect-element elem-door-outer" id="elem-door-outer"><i class="fa-solid fa-door-open me-1"></i>Dış Kapı</div>

            <div class="floor-divider"></div>

            <div class="section-label label-indoor">İÇERİ</div>
            <div class="section-label label-outdoor">DIŞARI</div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/floor-plan-management.js"></script>
}