@{
    ViewBag.Title = "Sipariş Takip";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/waiter-order-tracking.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="container-fluid mt-2">
    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-bell-concierge me-2" style="color: #4a154b;"></i>Sipariş Takip Paneli
            </h4>
            <p class="text-muted small mb-0">Mutfaktan çıkan siparişler burada kart olarak gözükür. İçeriğini görmek için karta tıklayabilir, teslim aldığınızda onaylayabilirsiniz.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Sadeleştirilmiş İkonsuz Bildirim Sesi Dropdown Menüsü -->
            <div class="dropdown">
                <button class="btn btn-outline-purple btn-sm rounded-3 px-3 dropdown-toggle d-flex align-items-center gap-2 h-38" type="button" id="dropdownWaiterSound" data-bs-toggle="dropdown" aria-expanded="false">
                    <span>Bildirim Sesi</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-1" aria-labelledby="dropdownWaiterSound">
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectWaiterSound('chime', true)">Zil (Klasik)</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectWaiterSound('double-beep', true)">Çift Bip (Eko)</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectWaiterSound('melody', true)">Melodik (Üçlü)</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectWaiterSound('alarm', true)">Yüksek Alarm</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectWaiterSound('whistle', true)">Mutfak Düdüğü</a></li>
                    <li><a class="dropdown-item py-2 small fw-medium" href="javascript:void(0);" onclick="selectWaiterSound('digital', true)">Dijital Bip</a></li>
                </ul>
            </div>

            <span class="badge bg-warning text-dark fs-6 px-3 rounded-3 h-38 d-flex align-items-center" id="waiterOrdersBadge">0 Sipariş Hazır</span>
        </div>
    </div>

    <!-- Mutfaktan Çıkan Hazır Sipariş Kartları Grid Alanı -->
    <div class="row g-3" id="waiterReadyOrdersGrid">
        <div class="col-12 text-center py-5 text-muted">
            <i class="fa-solid fa-spinner fa-spin fs-3 mb-3 d-block" style="color: #4a154b;"></i>
            <span>Hazır siparişler yükleniyor...</span>
        </div>
    </div>
</div>

<!-- SOL ALT CANLI TOAST BİLDİRİM CONTAINER -->
<div id="waiterToastContainer"></div>

<!-- GARSON SİPARİŞ İÇERİĞİ VE DETAY MODALI -->
<div class="modal fade" id="waiterOrderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center mb-0" id="waiterModalOrderTitle">
                    <i class="fa-solid fa-receipt me-2" style="color: #4a154b;"></i>Sipariş Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3">
                    <div>
                        <span class="text-muted small d-block">Sipariş Saati:</span>
                        <strong id="waiterLblOrderTime" class="text-dark">--:--</strong>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Durumu:</span>
                        <span id="waiterLblOrderStatusBadge" class="badge bg-secondary">--</span>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-utensils me-2" style="color: #4a154b;"></i>Sipariş Edilen Ürünler</h6>
                <div class="table-responsive border rounded-3 overflow-hidden mb-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="py-2 px-3 small text-muted">Ürün Adı</th>
                                <th class="py-2 px-3 small text-muted text-center">Adet</th>
                                <th class="py-2 px-3 small text-muted text-end">Fiyat</th>
                                <th class="py-2 px-3 small text-muted text-end">Toplam</th>
                                <th class="py-2 px-3 small text-muted text-center" style="width: 70px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="waiterTblOrderItemsBody">
                            <!-- JS Tarafından Doldurulacak -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <span class="fw-bold text-dark fs-6">Genel Toplam:</span>
                    <span id="waiterLblOrderTotalAmount" class="fw-bold fs-5" style="color: #4a154b;">0.00 ₺</span>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4" id="waiterModalFooterActions">
                <!-- Teslim Aldım Butonu İle Doldurulacak -->
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/Library/scripts/waiterOrderTracking.js?v=@DateTime.Now.Ticks"></script>
}