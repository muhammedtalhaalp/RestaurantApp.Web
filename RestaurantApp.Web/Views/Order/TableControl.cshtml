@{
    ViewBag.Title = "Masa Kontrolü";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/table-control.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="container-fluid mt-2">
    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-chair me-2" style="color: #4a154b;"></i>Masa Kontrolü
            </h4>
            <p class="text-muted small mb-0">Masaları taşıyabilir, adisyonları birleştirebilir, ürün veya tutar bazlı parçalı ödeme alabilirsiniz.</p>
        </div>
        <span class="badge rounded-pill p-2 px-3 fw-bold" id="occupiedCountBadge" style="background-color: #4a154b; color: #fff;">
            0 Dolu Masa
        </span>
    </div>

    <!-- DOLU MASALAR KART LİSTESİ -->
    <div class="row g-3" id="occupiedTablesContainer">
        <div class="col-12 text-center py-5 text-muted">
            <i class="fa-solid fa-spinner fa-spin fs-3 mb-2 d-block" style="color: #4a154b;"></i>
            <span>Dolu masalar yükleniyor...</span>
        </div>
    </div>
</div>

<!-- 1. MASA ADİSYON DETAY & İADE MODALI -->
<div class="modal fade" id="waiterTableCheckoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="waiterCheckoutModalTitle">
                    <i class="fa-solid fa-receipt me-2" style="color: #4a154b;"></i>Masa Adisyon Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="waiterCheckoutTableId" />
                <input type="hidden" id="waiterIsPaidState" value="false" />

                <!-- İADE BİLGİ VE GİRİŞ KUTUSU -->
                <div id="waiterReturnReasonContainer" class="card border-danger bg-danger-subtle p-3 rounded-3 mb-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-danger-emphasis"><i class="fa-solid fa-rotate-left me-1"></i><span id="lblWaiterReturnProductName">Ürün</span> İade Ediliyor</strong>
                        <button type="button" class="btn-close btn-sm" onclick="cancelWaiterReturnInput()"></button>
                    </div>
                    <input type="hidden" id="selectedWaiterReturnDetailId" />
                    <div class="input-group">
                        <input type="text" id="txtWaiterReturnReasonInput" class="form-control rounded-start-3" placeholder="İade sebebini yazınız (Örn: Soğuk geldi...)" autocomplete="off" />
                        <button type="button" class="btn btn-danger fw-bold px-3" id="btnConfirmWaiterReturnAction">
                            <i class="fa-solid fa-check me-1"></i>İadeyi Onayla
                        </button>
                    </div>
                </div>

                <!-- Sipariş Kalemleri Tablosu -->
                <div class="table-responsive mb-3" style="max-height: 250px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ürün Adı</th>
                                <th class="text-center">Adet</th>
                                <th class="text-end">B.Fiyat</th>
                                <th class="text-end">Tutar</th>
                                <th class="text-center" style="width: 110px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="waiterCheckoutItemsBody">
                            <!-- JS Çizecek -->
                        </tbody>
                    </table>
                </div>

                <!-- Toplam Tutar Göstergesi -->
                <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                    <span class="fs-6 fw-bold text-dark">Kalan Adisyon Borcu:</span>
                    <div class="text-end">
                        <span id="waiterCheckoutGrandTotal" class="fs-4 fw-bold style-purple-text">0.00 ₺</span>
                        <span id="waiterModalPaidStatusBadge" class="badge bg-success ms-2 d-none">HESAP KAPATILDI</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-3 fw-bold rounded-3" data-bs-dismiss="modal">Kapat</button>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary px-3 fw-bold rounded-3 shadow-sm" id="btnOpenPaymentModal">
                        <i class="fa-solid fa-credit-card me-2"></i>Ödeme Al 
                    </button>
                    <button type="button" class="btn btn-success px-3 fw-bold rounded-3 shadow-sm d-none" id="btnVacateTableAction">
                        <i class="fa-solid fa-door-open me-2"></i>Masayı Boşalt
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. GELİŞMİŞ PARÇALI / ÜRÜN BAZLI ÖDEME MODALI -->
<div class="modal fade" id="splitPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-calculator me-2" style="color: #4a154b;"></i> Ödeme Al
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">

                <!-- ÖDEME YÖNTEMİ SEKMELERİ (ÜRÜN SEÇ VEYA TUTAR GİR) -->
                <ul class="nav nav-pills nav-fill mb-3 p-1 bg-light rounded-3 border" id="payMethodTabs">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold py-2 rounded-3" id="tabPayByItems" data-bs-toggle="pill" data-bs-target="#panePayByItems">
                              Ürün Seçerek Öde
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold py-2 rounded-3" id="tabPayByAmount" data-bs-toggle="pill" data-bs-target="#panePayByAmount">
                             Serbest Tutar Girerek Öde
                        </button>
                    </li>
                </ul>

                <div class="tab-content mb-3">
                    <!-- 1. SEKME: ÜRÜN SEÇEREK ÖDEME -->
                    <div class="tab-pane fade show active" id="panePayByItems">
                        
                        <div class="table-responsive border rounded-3" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ürün</th>
                                        <th class="text-center">Masadaki Adet</th>
                                        <th class="text-end">Fiyat</th>
                                        <th class="text-center" style="width: 140px;">Ödenecek Adet</th>
                                    </tr>
                                </thead>
                                <tbody id="splitPayItemsTableBody">
                                    <!-- JS dolduracak -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 2. SEKME: SERBEST TUTAR GİREREK ÖDEME -->
                    <div class="tab-pane fade" id="panePayByAmount">
                        <div class="p-3 bg-light border rounded-3 mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-secondary small">Masa Toplam Borcu:</span>
                                <span id="lblFreePayTableTotal" class="fw-bold fs-5 text-dark">0.00 ₺</span>
                            </div>
                            <label class="form-label fw-bold small text-dark mb-1"> Tahsil Edilecek Tutar (₺):</label>
                            <input type="number" step="0.01" id="txtCustomPayAmount" class="form-control form-control-lg fw-bold text-center style-purple-text" placeholder="0.00" />
                        </div>
                    </div>
                </div>

                <!-- SEÇİLEN VEYA GİRİLEN TAHSİLAT TUTARI KARTI -->
                <div class="p-3 rounded-3 bg-purple-subtle border mb-3 text-center">
                    <span class="text-muted small d-block mb-1 fw-bold">ŞİMDİ ALINACAK TOPLAM TAHSİLAT</span>
                    <span id="lblTargetPayAmount" class="fs-3 fw-bold style-purple-text">0.00 ₺</span>
                </div>

                <!-- ÖDEME TÜRÜ DAĞILIMI (Nakit / Kredi Kartı / Yemek Kartı) -->
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <label class="form-label extra-small fw-bold text-dark">Nakit</label>
                        <input type="number" step="0.01" id="numCashPay" class="form-control fw-bold pay-input" placeholder="0.00" />
                    </div>
                    <div class="col-4">
                        <label class="form-label extra-small fw-bold text-dark">Kredi Kartı</label>
                        <input type="number" step="0.01" id="numCreditPay" class="form-control fw-bold pay-input" placeholder="0.00" />
                    </div>
                    <div class="col-4">
                        <label class="form-label extra-small fw-bold text-dark">Yemek Kartı</label>
                        <input type="number" step="0.01" id="numMealPay" class="form-control fw-bold pay-input" placeholder="0.00" />
                    </div>
                </div>

                <div class="p-2 px-3 rounded-3 border d-flex justify-content-between align-items-center bg-light">
                    <span class="small fw-bold text-muted">Ödeme Dağılımı Dengesi:</span>
                    <span id="lblPayRemaining" class="fw-bold fs-6 text-danger">0.00 ₺</span>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-3 fw-bold rounded-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success px-4 fw-bold rounded-3" id="btnFinalizeSplitPayment" disabled>
                    <i class="fa-solid fa-check me-1"></i>Tahsilatı Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 3. KARTLI MASA TAŞI VE BİRLEŞTİR MODALI -->
<div class="modal fade" id="transferMergeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="transferMergeModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="tmSourceTableId" />
                <input type="hidden" id="tmSelectedTargetTableId" />
                <input type="hidden" id="tmActionType" value="transfer" />

                <div class="d-flex gap-2 mb-3 overflow-x-auto pb-2" id="tmSectionTabs">
                    <button class="btn btn-sm btn-purple-tab active px-3 rounded-pill fw-bold" onclick="filterTargetTablesBySection('Tümü')">Tümü</button>
                </div>

                <div class="row g-2 overflow-y-auto p-1" style="max-height: 320px;" id="targetTablesCardGrid"></div>
                <div class="alert alert-info extra-small mb-0 mt-3 rounded-3" id="tmActionInfoAlert"></div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light">
                <button type="button" class="btn btn-secondary px-3 fw-bold rounded-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-purple-action px-4 fw-bold rounded-3" id="btnConfirmTransferMerge" disabled>
                    <i class="fa-solid fa-check me-1"></i>İşlemi Onayla
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/table-control.js?v=@DateTime.Now.Ticks"></script>
}