@{
    ViewBag.Title = "Masa Kontrolü";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/table-control.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="container-fluid mt-2">
    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-chair me-2" style="color: #4a154b;"></i>Masa Kontrolü
            </h4>
            <p class="text-muted small mb-0">Müşterisi kalkan masaları inceleyebilir, iade alabilir ve tek tıkla boş durumuna alabilirsiniz.</p>
        </div>
        <span class="badge rounded-pill p-2 px-3 fw-bold" id="occupiedCountBadge" style="background-color: #4a154b; color: #fff;">
            0 Dolu Masa
        </span>
    </div>

    <!-- DOLU MASALAR KART LİSTESİ -->
    <div class="row g-3" id="occupiedTablesContainer">
        <div class="col-12 text-center py-5 text-muted">
            <i class="fa-solid fa-spinner fa-spin fs-3 mb-2 d-block" style="color: #4a154b;"></i>
            <span>Dolu masalar yükleniyor...</span>
        </div>
    </div>
</div>

<!-- GARSON MASA ADİSYON & İADE MODALI -->
<div class="modal fade" id="waiterTableCheckoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="waiterCheckoutModalTitle">
                    <i class="fa-solid fa-receipt me-2" style="color: #4a154b;"></i>Masa Adisyon Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="waiterCheckoutTableId" />

                <!-- İADE BİLGİ VE GİRİŞ KUTUSU -->
                <div id="waiterReturnReasonContainer" class="card border-danger bg-danger-subtle p-3 rounded-3 mb-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-danger-emphasis"><i class="fa-solid fa-rotate-left me-1"></i><span id="lblWaiterReturnProductName">Ürün</span> İade Ediliyor</strong>
                        <button type="button" class="btn-close btn-sm" onclick="cancelWaiterReturnInput()"></button>
                    </div>
                    <input type="hidden" id="selectedWaiterReturnDetailId" />
                    <div class="input-group">
                        <input type="text" id="txtWaiterReturnReasonInput" class="form-control rounded-start-3" placeholder="İade sebebini yazınız (Örn: Soğuk geldi, Yanlış sipariş...)" autocomplete="off" />
                        <button type="button" class="btn btn-danger fw-bold px-3" id="btnConfirmWaiterReturnAction">
                            <i class="fa-solid fa-check me-1"></i>İadeyi Onayla
                        </button>
                    </div>
                </div>

                <div class="alert alert-light border rounded-3 mb-3 d-flex justify-content-between align-items-center py-2 px-3">
                    <span class="small text-muted mb-0"><i class="fa-solid fa-circle-info me-1 text-primary"></i>İade etmek istediğiniz ürünün yanındaki <b>"İade Et"</b> butonuna basıp sebebini yazınız.</span>
                </div>

                <!-- Sipariş Kalemleri Tablosu -->
                <div class="table-responsive mb-3" style="max-height: 280px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ürün Adı</th>
                                <th class="text-center">Adet</th>
                                <th class="text-end">B.Fiyat</th>
                                <th class="text-end">Tutar</th>
                                <th class="text-center" style="width: 110px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="waiterCheckoutItemsBody">
                            <!-- JS Çizecek -->
                        </tbody>
                    </table>
                </div>

                <!-- Toplam Hesap Kutusu -->
                <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                    <span class="fs-6 fw-bold text-dark">Tahsil Edilecek Net Tutar:</span>
                    <span id="waiterCheckoutGrandTotal" class="fs-4 fw-bold text-danger">0.00 ₺</span>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-4 fw-bold rounded-3" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-success px-4 fw-bold rounded-3 shadow-sm" id="btnWaiterCloseTableOrder">
                    <i class="fa-solid fa-credit-card me-2"></i>Ödeme Alındı & Masayı Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/table-control.js?v=@DateTime.Now.Ticks"></script>
}