@{
    ViewBag.Title = "POS & Sipariş Ekranı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Library/styles/pos.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <style>
        #map {
            width: 100%;
            height: 220px;
            border-radius: 12px;
            border: 1px solid #cbd5e1;
        }

        .pac-container {
            z-index: 10000 !important;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            font-family: 'Poppins', sans-serif;
            border: 1px solid #e2e8f0;
        }
    </style>
}

<div class="row g-0">
    <!-- SOL TARAF: Sipariş Yönetimi ve Ürün Kataloğu (8 Kolon) -->
    <div class="col-md-8 p-4">
        <!-- Sipariş Başlığı & Seçilen Hedef Rozeti -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">
                    <i class="fa-solid fa-utensils me-2" style="color: #4a154b;"></i>Sipariş Yönetimi
                </h4>
                <p class="text-muted small mb-0">Önce sağ taraftan sipariş türü ve masa/adres seçimi yapınız.</p>
            </div>
            <!-- Seçim Tamamlanınca Açılan Bilgi Rozeti -->
            <div id="targetSelectedBadge" class="d-none">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6 fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i><span id="lblSelectedTargetName">Masa-1</span>
                </span>
                <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none ms-1 extra-small fw-bold" onclick="resetTargetSelection()">
                    <i class="fa-solid fa-rotate-left me-1"></i>Değiştir
                </button>
            </div>
        </div>

        <!-- Ürünler Kataloğu Kapsayıcısı -->
        <div id="menuCatalogContainer">
            <!-- KATEGORİLER VE GÖRÜNÜM BUTONLARI -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div id="category-list" class="d-flex flex-wrap align-items-center">
                    <button class="btn btn-primary category-btn active" data-id="0" onclick="filterCategory(0, this)">
                        <i class="fa-solid fa-list me-1"></i>Tüm Ürünler
                    </button>
                </div>

                <!-- Görünüm Değiştirici Butonlar -->
                <div class="btn-group shadow-sm ms-2" role="group">
                    <button type="button" class="btn btn-sm btn-purple-main active px-3" id="btnGridView" title="Izgara Görünümü (Resimli)">
                        <i class="fa-solid fa-border-all"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="btnTableView" title="Tablo Görünümü (Resimsiz)">
                        <i class="fa-solid fa-list-ul"></i>
                    </button>
                </div>
            </div>

            <hr />

            <!-- Ürünler Alanı -->
            <div id="product-list" class="row g-3">
                <!-- AJAX ile dinamik yüklenecek -->
            </div>
        </div>
    </div>

    <!-- SAĞ TARAF: Adım 1 Hedef Seçimi & Adım 2 Sepet Paneli (4 Kolon) -->
    <div class="col-md-4 cart-container p-4 d-flex flex-column">

        <!-- ADIM 1: SİPARİŞ HEDEFİ SEÇİM PANELİ -->
        <div id="stepTargetSelectionPanel">
            <h5 class="fw-bold mb-3" style="color: #4a154b;">
                <span class="badge rounded-circle bg-purple-main text-white me-2 px-2 py-1">1</span>Masa/Paket Servisi
            </h5>

            <div class="card border p-3 rounded-4 bg-light mb-3 shadow-sm text-center py-4">
                <i class="fa-solid fa-chair fs-1 text-muted mb-2 opacity-50"></i>
                <p class="text-muted small mb-3">Siparişe başlamak için lütfen masa veya paket servis seçimi yapınız.</p>
                <button class="btn btn-purple-main fw-bold py-2.5 px-3 rounded-3 w-100 shadow-sm" type="button" onclick="openInitialModal()">
                    <i class="fa-solid fa-layer-group me-2"></i>Masa / Paket Seç
                </button>
            </div>

            <!-- Gizli Inputlar -->
            <input type="hidden" id="orderType" value="Masa" />
            <input type="hidden" id="tableId" value="" />
        </div>

        <!-- ADIM 2: SEPET VE SİPARİŞ ONAY PANELİ -->
        <div id="stepCartPanel" class="flex-grow-1 d-flex flex-column" style="display: none !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold mb-0 text-dark">
                    <span class="badge rounded-circle bg-success text-white me-2 px-2 py-1">2</span>2. Adım: Aktif Sepet
                </h5>
            </div>
            <hr class="my-2" />

            <!-- Sepet Tablosu -->
            <div class="flex-grow-1 overflow-auto mb-3" style="max-height: 280px;">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ürün</th>
                            <th style="width: 80px;">Adet</th>
                            <th class="text-end">Fiyat</th>
                            <th style="width: 35px;" class="text-center">Sil</th>
                        </tr>
                    </thead>
                    <tbody id="cart-items">
                        <!-- Sepete eklenen ürünler -->
                    </tbody>
                </table>
            </div>

            <!-- Toplam Tutar ve Onay Butonu -->
            <div class="pt-3 border-top mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-5 fw-bold text-dark">Toplam Tutar:</span>
                    <span id="total-price" class="fs-4 fw-bold text-success">0.00 ₺</span>
                </div>
                <button id="btn-submit-order" class="btn btn-success w-100 btn-lg fw-bold rounded-3 shadow-sm">
                    <i class="fa-solid fa-check me-2"></i>Siparişi Onayla
                </button>
            </div>
        </div>
    </div>
</div>

<!-- TERMAL FİŞ YAZDIRMA ALANI (GİZLİ ELEMAN) -->
<div id="thermalReceiptPrintArea" class="printable-receipt-container">
    <div class="receipt-header text-center mb-2">
        <h3 class="fw-bold mb-0">LezzetPOS</h3>
        <p class="receipt-sub-title mb-1">Restoran & Otomasyon Sistemi</p>
        <div class="receipt-divider">--------------------------------</div>
    </div>

    <div class="receipt-info mb-2">
        <div><strong>Tarih:</strong> <span id="receiptDate">11.08.2026 16:30</span></div>
        <div><strong>Sipariş Hedefi:</strong> <span id="receiptTargetName">Masa-1</span></div>
        <div id="receiptAddressRow" class="d-none"><strong>Adres:</strong> <span id="receiptAddressText">--</span></div>
    </div>

    <div class="receipt-divider">--------------------------------</div>

    <table class="receipt-table w-100 mb-2">
        <thead>
            <tr>
                <th class="text-start">Ürün</th>
                <th class="text-center">Adet</th>
                <th class="text-end">B.Fiyat</th>
                <th class="text-end">Tutar</th>
            </tr>
        </thead>
        <tbody id="receiptItemsBody">
            <!-- Fiş Ürünleri Dinamik Dolacak -->
        </tbody>
    </table>

    <div class="receipt-divider">--------------------------------</div>

    <div class="receipt-total d-flex justify-content-between fw-bold fs-6 my-2">
        <span>GENEL TOPLAM:</span>
        <span id="receiptTotalAmount">0.00 ₺</span>
    </div>

    <div class="receipt-divider">--------------------------------</div>

    <div class="text-center receipt-footer mt-2">
        <p class="mb-0">Afiyet Olsun!</p>
        <small>Yine Bekleriz</small>
    </div>
</div>

<!-- 1. ANA TÜR SEÇİM MODALI -->
<div class="modal fade" id="initialOrderTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4 position-relative">
            <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-layer-group me-2" style="color: #4a154b;"></i>Sipariş Türünü Seçin</h5>
            <p class="text-muted small mb-4">Lütfen işleme devam etmek için sipariş yöntemini seçiniz.</p>

            <div class="row g-3">
                <div class="col-6">
                    <button type="button" class="btn btn-outline-primary w-100 py-4 rounded-4 shadow-sm fw-bold d-flex flex-column align-items-center justify-content-center gap-2" onclick="selectInitialOrderType('Masa')">
                        <i class="fa-solid fa-chair fa-2x"></i>
                        <span>Masa Siparişi</span>
                    </button>
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-outline-warning text-dark w-100 py-4 rounded-4 shadow-sm fw-bold d-flex flex-column align-items-center justify-content-center gap-2" onclick="selectInitialOrderType('PaketServis')">
                        <i class="fa-solid fa-motorcycle fa-2x"></i>
                        <span>Paket Servis</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. MASA SEÇİM MODALI (Kartlı) -->
<div class="modal fade" id="posTableMapModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-chair me-2" style="color: #4a154b;"></i>Masa Seçimi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <ul class="nav nav-pills nav-fill gap-2 mb-3" id="posSectionTabs">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold py-2 rounded-3" data-section="Hepsi">Tümü</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold py-2 rounded-3" data-section="Salon">Salon</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold py-2 rounded-3" data-section="Bahçe">Bahçe</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold py-2 rounded-3" data-section="Balkon">Balkon</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold py-2 rounded-3" data-section="Teras">Teras</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold py-2 rounded-3" data-section="Üst Kat">Üst Kat</button>
                    </li>
                </ul>

                <div class="row g-3" id="posTableCardGrid" style="max-height: 480px; overflow-y: auto;">
                    <!-- JS Çizecek -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. PAKET SERVİS MODALI (Adres & Harita) -->
<div class="modal fade" id="posPaketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-motorcycle me-2" style="color: #4a154b;"></i>Paket Servis Teslimat Adresi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary"><i class="fa-solid fa-location-dot me-1" style="color: #4a154b;"></i>Açık Adres:</label>
                    <input type="text" id="txtDeliveryAddress" class="form-control" placeholder="Açık adres yazın (Örn: Atatürk Cad. No:5...)" autocomplete="off" />
                </div>
                <label class="form-label fw-bold small text-muted">Teslimat Konumu:</label>
                <div id="map" class="mb-3"></div>
                <input type="hidden" id="latitude" />
                <input type="hidden" id="longitude" />
                <button type="button" class="btn btn-purple-main w-100 fw-bold py-2.5 rounded-3 shadow-sm" onclick="confirmPaketServisModal()">
                    <i class="fa-solid fa-check me-2"></i>Adresi Onayla ve Siparişe Başla
                </button>
            </div>
        </div>
    </div>
</div>

<!-- YEMEK BÜYÜTME & DETAY MODALI -->
<div class="modal fade" id="productDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="modalProductName">Ürün Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <img id="modalProductImage" src="" class="img-fluid rounded-4 shadow-sm mb-3" style="max-height: 220px; width: 100%; object-fit: cover;" />
                <div class="mb-2">
                    <span id="modalProductCategory" class="badge bg-light text-dark border px-2 py-1">Kategori</span>
                </div>
                <p id="modalProductDescription" class="text-muted small mb-3">Açıklama yükleniyor...</p>
                <div class="fs-3 fw-bold mb-3" style="color: #4a154b;" id="modalProductPrice">0.00 ₺</div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-purple px-4 fw-bold" id="btnModalAddToCart">
                    <i class="fa-solid fa-cart-plus me-1"></i>Sepete Ekle
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Library/scripts/pos.js?v=@DateTime.Now.Ticks"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB4PzsQaSlz70n5upY-1Ha30lrk_makrQo&libraries=places&callback=initGoogleMap" async defer></script>
}