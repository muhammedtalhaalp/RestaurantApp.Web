<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LezzetPOS</title>

    <!-- Modern Font: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CDN Kütüphaneleri -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" rel="stylesheet" />

    <!-- Proje Ana CSS -->
    <link href="~/Library/styles/my-site.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 75px;
            --sidebar-bg: #1e232a;
            --sidebar-active-bg: #2b313a;
            --primary-purple: #4a154b;
            --primary-purple-hover: #381039;
            --bg-light: #eef2f6;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-light);
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        .wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        #sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            color: #fff;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 1000;
            position: fixed;
            top: 16px;
            left: 16px;
            bottom: 16px;
            height: calc(100vh - 32px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            padding: 10px 8px;
            overflow-y: auto;
            overflow-x: hidden;
        }

            #sidebar.collapsed {
                width: var(--sidebar-collapsed-width);
            }

            #sidebar .brand-logo {
                padding: 16px 16px;
                display: flex;
                align-items: center;
                gap: 12px;
                color: #fff;
                text-decoration: none;
                font-weight: 700;
                font-size: 1.2rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

                #sidebar .brand-logo i {
                    color: var(--primary-purple);
                    font-size: 1.4rem;
                    background: #ffffff;
                    width: 36px;
                    height: 36px;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

            #sidebar.collapsed .brand-text {
                display: none;
            }

        .sidebar-menu {
            list-style: none;
            padding: 15px 0;
            margin: 0;
            flex: 1;
        }

            .sidebar-menu li {
                margin-bottom: 4px;
            }

                .sidebar-menu li a {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 12px 18px;
                    color: #9aa5b1;
                    text-decoration: none;
                    font-size: 0.95rem;
                    font-weight: 500;
                    border-radius: 14px;
                    transition: all 0.2s;
                }

                    .sidebar-menu li a:hover, .sidebar-menu li.active > a {
                        color: #fff;
                        background: var(--sidebar-active-bg);
                    }

        .submenu-list {
            list-style: none;
            padding-left: 36px;
            margin-top: 4px;
        }

            .submenu-list li a {
                padding: 8px 14px;
                font-size: 0.88rem;
                color: #9aa5b1;
            }

                .submenu-list li a:hover, .submenu-list li.active a {
                    color: #fff !important;
                    background: rgba(255, 255, 255, 0.08) !important;
                }

        #sidebar.collapsed .link-text,
        #sidebar.collapsed .submenu-arrow,
        #sidebar.collapsed .submenu-list {
            display: none !important;
        }

        .sidebar-footer {
            padding: 12px 8px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .btn-toggle-sidebar {
            background: rgba(255, 255, 255, 0.05);
            border: none;
            color: #9aa5b1;
            width: 100%;
            text-align: center;
            padding: 8px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-toggle-sidebar:hover {
                color: #fff;
                background: rgba(255, 255, 255, 0.1);
            }

        .btn-logout {
            color: #e53e3e;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            font-weight: 600;
            padding: 10px 16px;
            border-radius: 12px;
            transition: all 0.2s;
        }

            .btn-logout:hover {
                color: #fc8181;
                background: rgba(229, 62, 62, 0.1);
            }

        #sidebar.collapsed .logout-text {
            display: none;
        }

        #content {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            margin-left: calc(var(--sidebar-width) + 32px);
            transition: margin-left 0.3s ease;
        }

            #content.expanded {
                margin-left: calc(var(--sidebar-collapsed-width) + 32px);
            }

        .top-navbar {
            background: #fff;
            padding: 14px 28px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 20px;
            border-bottom: 1px solid #edf2f7;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            color: #2d3748;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary-purple);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }

        .user-profile.dropdown-toggle::after {
            display: none !important;
        }

        .dropdown-menu .dropdown-item:active {
            background-color: var(--primary-purple) !important;
            color: #fff !important;
        }

            .dropdown-menu .dropdown-item:active i {
                color: #fff !important;
            }

        .notification-item {
            transition: background-color 0.2s ease;
            cursor: pointer;
        }

            .notification-item:hover {
                background-color: #f8f9fa !important;
            }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- Sol Sidebar -->
        <nav id="sidebar">
            <div>
                <a href="javascript:void(0);" class="brand-logo">
                    <i class="fa-solid fa-leaf"></i>
                    <span class="brand-text">LezzetPOS</span>
                </a>

                <!-- DİNAMİK ROL MENÜSÜ -->
                <ul class="sidebar-menu" id="mainSidebarMenu">
                    @{
                        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                        string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : (Session["Role"] != null ? Session["Role"].ToString() : "");
                    }

                    @if (userRole == "Admin")
                    {
                        <li class="@(currentAction == "Index" ? "active" : "")">
                            <a href="/Admin/Index">
                                <i class="fa-solid fa-house"></i>
                                <span class="link-text">Ana Sayfa</span>
                            </a>
                        </li>
                        <li class="@(currentAction == "Dashboard" ? "active" : "")">
                            <a href="/Admin/Dashboard">
                                <i class="fa-solid fa-sliders"></i>
                                <span class="link-text">Kontrol Paneli</span>
                            </a>
                        </li>
                        <li class="@(currentAction == "StaffManagement" ? "active" : "")">
                            <a href="/Admin/StaffManagement">
                                <i class="fa-solid fa-users-gear"></i>
                                <span class="link-text">Personel Yönetimi</span>
                            </a>
                        </li>
                        <li class="@(currentAction == "OrderTracking" ? "active" : "")">
                            <a href="/Admin/OrderTracking">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                <span class="link-text">Sipariş Takip</span>
                            </a>
                        </li>
                        <li class="@(currentAction == "KitchenReport" ? "active" : "")">
                            <a href="/Admin/KitchenReport">
                                <i class="fa-solid fa-receipt"></i>
                                <span class="link-text">Mutfak Raporu</span>
                            </a>
                        </li>
                        <!-- MASA YÖNETİMİ AÇILIR MENÜ -->
                        <li class="@(currentAction == "TableManagement" || currentAction == "FloorPlanManagement" ? "active" : "")">
                            <a class="d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#tableSubMenu" role="button" aria-expanded="false">
                                <span><i class="fa-solid fa-chair me-2"></i><span class="link-text">Masa Yönetimi</span></span>
                                <i class="fa-solid fa-chevron-down small submenu-arrow"></i>
                            </a>
                            <div class="collapse" id="tableSubMenu">
                                <ul class="submenu-list">
                                    <li class="@(currentAction == "TableManagement" ? "active" : "")">
                                        <a href="/Admin/TableManagement"><span class="link-text">Yeni Masa Ekle</span></a>
                                    </li>
                                    <li class="@(currentAction == "FloorPlanManagement" ? "active" : "")">
                                        <a href="/Admin/FloorPlanManagement"><span class="link-text">Kroki Yönetimi</span></a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    }
                    else if (userRole.Contains("Garson") || userRole.Contains("Kasiyer"))
                    {
                        <li class="@(currentAction == "POS" || currentAction == "Pos" ? "active" : "")">
                            <a href="/Order/POS" class="nav-link">
                                <i class="fa-solid fa-utensils me-2"></i><span class="link-text">Sipariş Yönetimi</span>
                            </a>
                        </li>
                        <li class="@(currentAction == "WaiterOrderTracking" ? "active" : "")">
                            <a href="/Order/WaiterOrderTracking" class="nav-link">
                                <i class="fa-solid fa-bell-concierge me-2"></i><span class="link-text">Sipariş Takip</span>
                            </a>
                        </li>
                        <li class="@(currentAction == "TableControl" ? "active" : "")">
                            <a href="/Table/TableControl" class="nav-link">
                                <i class="fa-solid fa-chair me-2"></i><span class="link-text">Masa Kontrolü</span>
                            </a>
                        </li>
                    }
                    else if (userRole.Contains("Mutfak"))
                    {
                        <li class="@(currentAction == "Index" ? "active" : "")">
                            <a href="/Kitchen/Index">
                                <i class="fa-solid fa-fire-burner"></i>
                                <span class="link-text">Mutfak Ekranı</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="sidebar-footer">
                <button class="btn-toggle-sidebar mb-2" id="sidebarToggle">
                    <i class="fa-solid fa-chevron-left" id="toggleIcon"></i>
                </button>
                <a href="/Auth/Login" class="btn-logout" id="btnLogout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="logout-text">Güvenli Çıkış</span>
                </a>
            </div>
        </nav>

        <!-- Sağ Taraf İçerik -->
        <div id="content">
            <header class="top-navbar">
                <!-- BİLDİRİM ZİLİ DROPDOWN -->
                <div class="dropdown me-2" id="notificationDropdownContainer">
                    <a class="position-relative text-muted text-decoration-none dropdown-toggle cursor-pointer" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 1.25rem;">
                        <i class="fa-regular fa-bell"></i>
                        <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; display: none;">
                            0
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2" aria-labelledby="notificationDropdown" style="width: 320px; border-radius: 16px; max-height: 380px; overflow-y: auto;">
                        <div class="dropdown-header fw-bold text-dark border-bottom pb-2 mb-2 d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-bell me-2 text-warning"></i>Hazır Siparişler</span>
                            <span class="badge bg-light text-dark border" id="notificationCountText">0 Sipariş</span>
                        </div>
                        <ul class="list-unstyled mb-0" id="notificationItemsContainer">
                            <li class="text-center py-3 text-muted small" id="noNotificationText">Hazır bekleyen sipariş bulunmuyor.</li>
                        </ul>
                    </div>
                </div>

                <!-- Profile Dropdown -->
                <div class="dropdown" id="profileDropdownContainer">
                    <div class="user-profile dropdown-toggle" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                        <div class="user-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <span id="lblFullName">Kullanıcı</span>
                        <i class="fa-solid fa-chevron-down ms-1 text-muted" id="profileArrowIcon" style="font-size: 0.75rem; transition: transform 0.2s;"></i>
                    </div>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userProfileDropdown" style="border-radius: 12px; min-width: 180px;">
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/Auth/ProfileSettings">
                                <i class="fa-solid fa-user-gear" style="color: #4a154b;"></i>
                                <span>Profil Ayarları</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider opacity-50"></li>
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger fw-semibold" href="/Auth/Login">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span>Güvenli Çıkış</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- CDN JS Kütüphaneleri -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // GLOBAL BİLDİRİM ÇEKİCİ FONKSİYON
        function fetchLayoutNotifications() {
            var serverRole = "@userRole";
            var localRole = (localStorage.getItem("Role") || "").trim();

            // Mutfak ise çalıştırma
            if (serverRole.includes('Mutfak') || localRole.includes('Mutfak')) {
                return;
            }

            $.ajax({
                url: "/Admin/GetPendingDeliveryOrders",
                type: "GET",
                cache: false,
                success: function (res) {
                    var $badge = $("#notificationBadge");
                    var $countText = $("#notificationCountText");
                    var $container = $("#notificationItemsContainer");

                    if (res.success && res.data && res.data.length > 0) {
                        $badge.text(res.data.length).show();
                        $countText.text(`${res.data.length} Sipariş`);

                        // Rol kontrolü ile doğru sayfaya yönlendir
                        var targetUrl = (serverRole === 'Admin' || localRole === 'Admin')
                            ? '/Admin/OrderTracking'
                            : '/Order/WaiterOrderTracking';

                        var html = "";
                        $.each(res.data, function (i, order) {
                            var isMasa = order.orderType === "Masa";
                            var rawName = order.tableName || '';
                            var title = isMasa
                                ? (rawName.toLowerCase().startsWith('masa') ? rawName : `Masa ${rawName}`)
                                : "Paket Servis";

                            html += `
                                <li class="notification-item p-2 mb-1 rounded-3 border-bottom" onclick="window.location.href='${targetUrl}'">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">
                                            <i class="fa-solid fa-utensils me-1" style="color: #4a154b;"></i>${title}
                                        </span>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle extra-small" style="font-size: 0.7rem;">${order.orderDate}</span>
                                    </div>
                                    <p class="text-muted extra-small mb-0" style="font-size:0.78rem;">Sipariş mutfakta hazırlandı, servise hazır!</p>
                                </li>`;
                        });

                        $container.html(html);
                    } else {
                        $badge.hide().text("0");
                        $countText.text("0 Sipariş");
                        $container.html('<li class="text-center py-3 text-muted small" id="noNotificationText">Hazır bekleyen sipariş bulunmuyor.</li>');
                    }
                },
                error: function (err) {
                    console.error("Bildirimler çekilemedi:", err);
                }
            });
        }

        (function renderRoleSidebar() {
            var localRole = (localStorage.getItem("Role") || "").trim();
            var currentPath = window.location.pathname.toLowerCase();
            var menuHtml = '';

            var isTableActive = currentPath.includes('/admin/tablemanagement') || currentPath.includes('/admin/floorplanmanagement');

            // Admin kontrolü
            if (localRole === 'Admin' || currentPath.includes('/admin/')) {
                menuHtml = `
                                <li class="${currentPath.includes('/admin/index') ? 'active' : ''}">
                                    <a href="/Admin/Index"><i class="fa-solid fa-house"></i><span class="link-text">Ana Sayfa</span></a>
                                </li>
                                <li class="${currentPath.includes('/admin/dashboard') ? 'active' : ''}">
                                    <a href="/Admin/Dashboard"><i class="fa-solid fa-sliders"></i><span class="link-text">Kontrol Paneli</span></a>
                                </li>
                                <li class="${currentPath.includes('/admin/staffmanagement') ? 'active' : ''}">
                                    <a href="/Admin/StaffManagement"><i class="fa-solid fa-users-gear"></i><span class="link-text">Personel Yönetimi</span></a>
                                </li>
                                <li class="${currentPath.includes('/admin/ordertracking') ? 'active' : ''}">
                                    <a href="/Admin/OrderTracking"><i class="fa-solid fa-clock-rotate-left"></i><span class="link-text">Sipariş Takip</span></a>
                                </li>
                                <li class="${currentPath.includes('/admin/kitchenreport') ? 'active' : ''}">
                                    <a href="/Admin/KitchenReport"><i class="fa-solid fa-receipt"></i><span class="link-text">Mutfak Raporu</span></a>
                                </li>
                                <li class="${isTableActive ? 'active' : ''}">
                                    <a class="d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#tableSubMenu" role="button" aria-expanded="false">
                                        <span><i class="fa-solid fa-chair me-2"></i><span class="link-text">Masa Yönetimi</span></span>
                                        <i class="fa-solid fa-chevron-down small submenu-arrow"></i>
                                    </a>
                                    <div class="collapse" id="tableSubMenu">
                                        <ul class="submenu-list">
                                            <li class="${currentPath.includes('/admin/tablemanagement') ? 'active' : ''}">
                                                <a href="/Admin/TableManagement"><span class="link-text">Yeni Masa Ekle</span></a>
                                            </li>
                                            <li class="${currentPath.includes('/admin/floorplanmanagement') ? 'active' : ''}">
                                                <a href="/Admin/FloorPlanManagement"><span class="link-text">Kroki Yönetimi</span></a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>`;
            } else if (localRole.includes('Garson') || localRole.includes('Kasiyer')) {
                menuHtml = `
                                <li class="${currentPath.includes('/order/pos') ? 'active' : ''}">
                                    <a href="/Order/POS"><i class="fa-solid fa-utensils"></i><span class="link-text">Sipariş Yönetimi</span></a>
                                </li>
                                <li class="${currentPath.includes('/order/waiterordertracking') ? 'active' : ''}">
                                    <a href="/Order/WaiterOrderTracking"><i class="fa-solid fa-bell-concierge"></i><span class="link-text">Sipariş Takip</span></a>
                                </li>
                                <li class="${currentPath.includes('/table/tablecontrol') ? 'active' : ''}">
                                    <a href="/Table/TableControl"><i class="fa-solid fa-chair"></i><span class="link-text">Masa Kontrolü</span></a>
                                </li>`;
            } else if (localRole.includes('Mutfak')) {
                menuHtml = `
                                <li class="${currentPath.includes('/kitchen') ? 'active' : ''}">
                                    <a href="/Kitchen/Index"><i class="fa-solid fa-fire-burner"></i><span class="link-text">Mutfak Ekranı</span></a>
                                </li>`;
            } else {
                if (currentPath.includes('/order/') || currentPath.includes('/table/')) {
                    menuHtml = `
                                <li class="${currentPath.includes('/order/pos') ? 'active' : ''}">
                                    <a href="/Order/POS"><i class="fa-solid fa-utensils"></i><span class="link-text">Sipariş Yönetimi</span></a>
                                </li>
                                <li class="${currentPath.includes('/order/waiterordertracking') ? 'active' : ''}">
                                    <a href="/Order/WaiterOrderTracking"><i class="fa-solid fa-bell-concierge"></i><span class="link-text">Sipariş Takip</span></a>
                                </li>
                                <li class="${currentPath.includes('/table/tablecontrol') ? 'active' : ''}">
                                    <a href="/Table/TableControl"><i class="fa-solid fa-chair"></i><span class="link-text">Masa Kontrolü</span></a>
                                </li>`;
                } else if (currentPath.includes('/kitchen')) {
                    menuHtml = `<li class="active"><a href="/Kitchen/Index"><i class="fa-solid fa-fire-burner"></i><span class="link-text">Mutfak Ekranı</span></a></li>`;
                }
            }

            if (menuHtml !== '') {
                var menuElem = document.getElementById('mainSidebarMenu');
                if (menuElem) {
                    menuElem.innerHTML = menuHtml;
                }
            }
        })();

        $(document).ready(function () {
            // Bildirim çekicisini başlat
            fetchLayoutNotifications();
            setInterval(fetchLayoutNotifications, 8000);

            $('#sidebarToggle').on('click', function () {
                $('#sidebar').toggleClass('collapsed');
                $('#content').toggleClass('expanded');

                if ($('#sidebar').hasClass('collapsed')) {
                    $('#toggleIcon').removeClass('fa-chevron-left').addClass('fa-chevron-right');
                } else {
                    $('#toggleIcon').removeClass('fa-chevron-right').addClass('fa-chevron-left');
                }
            });

            let fullName = localStorage.getItem("FullName");
            if (fullName) {
                $('#lblFullName').text(fullName);
            }

            $('#btnLogout, a[href="/Auth/Login"]').on('click', function () {
                localStorage.clear();
            });

            const dropdownElement = document.getElementById('profileDropdownContainer');
            if (dropdownElement) {
                dropdownElement.addEventListener('show.bs.dropdown', function () {
                    $('#profileArrowIcon').removeClass('fa-chevron-down').addClass('fa-chevron-up');
                });
                dropdownElement.addEventListener('hide.bs.dropdown', function () {
                    $('#profileArrowIcon').removeClass('fa-chevron-up').addClass('fa-chevron-down');
                });
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>