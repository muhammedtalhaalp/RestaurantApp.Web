@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap / Kayıt Ol - LezzetPOS</title>

    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* GİRİŞ / KAYIT: mobil uygulamayla aynı koyu, premium tasarım (marka moru #4a154b).
           Görünüm geçişi JS ile .forms / .card-hero-inner / .active-bar "top" değerleriyle yapılır;
           panel yükseklikleri (520px) ve %200 / %33,33 oranları bu yüzden korunmalı. */
        :root {
            --color-primary: #4a154b;
            --color-primary-bright: #7b2d7e;
            --color-accent: #d9a6e3;
            --color-bg: #0e0911;
            --color-surface: rgba(255, 255, 255, 0.05);
            --color-border: rgba(255, 255, 255, 0.10);
            --color-text: #f6f1f8;
            --color-muted: #a99db0;
            --color-subtle: #6e6375;
            --brand-gradient: linear-gradient(135deg, #8e3a92 0%, #4a154b 60%, #2a0b2c 100%);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', system-ui, sans-serif;
        }

        body {
            background: var(--color-bg);
            color: var(--color-text);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            overflow-x: hidden;
            position: relative;
            -webkit-font-smoothing: antialiased;
        }

        /* Arka plan ışıkları */
        .glow {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(10px);
            z-index: 0;
        }

        .glow-1 {
            width: 620px;
            height: 620px;
            top: -260px;
            left: -200px;
            background: radial-gradient(circle, rgba(123, 45, 126, 0.55), transparent 70%);
        }

        .glow-2 {
            width: 680px;
            height: 680px;
            bottom: -300px;
            right: -240px;
            background: radial-gradient(circle, rgba(74, 21, 75, 0.5), transparent 70%);
        }

        /* Ana kart: cam efekti */
        .card {
            display: flex;
            align-content: stretch;
            width: min(820px, 100%);
            height: 520px;
            border-radius: 28px;
            background: var(--color-surface);
            -webkit-backdrop-filter: blur(22px);
            backdrop-filter: blur(22px);
            border: 1px solid var(--color-border);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
            position: relative;
            z-index: 1;
            animation: card-in 0.6s cubic-bezier(.2, .8, .2, 1) both;
        }

        @@keyframes card-in {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: none; }
        }

        /* Sol menü */
        .card-nav {
            position: relative;
            align-self: stretch;
            display: flex;
            flex-direction: column;
            justify-content: center;
            width: 128px;
            flex-shrink: 0;
            list-style: none;
            z-index: 2;
        }

            .card-nav li {
                flex: 1 1 auto;
                display: grid;
                place-items: center;
            }

            .card-nav .nav-logo {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                display: grid;
                place-items: center;
                color: #fff;
                font-size: 1.35rem;
                background: linear-gradient(135deg, #b06ab3, #7b2d7e 55%, #4a154b);
                box-shadow: 0 0 0 3px rgba(217, 166, 227, 0.25), 0 10px 30px rgba(123, 45, 126, 0.55);
            }

            .card-nav button {
                background: transparent;
                border: 0;
                display: flex;
                flex-direction: column;
                gap: 8px;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 100%;
                cursor: pointer;
                transition: color 0.3s, opacity 0.3s;
                color: var(--color-subtle);
                font-weight: 600;
                font-size: 0.82rem;
            }

                .card-nav button i {
                    font-size: 1.35rem;
                }

                .card-nav button:not(.active):hover {
                    color: var(--color-muted);
                }

                .card-nav button.active {
                    color: var(--color-accent);
                }

        /* Aktif sekme çizgisi */
        .active-bar {
            position: absolute;
            top: 33.33%;
            left: 0;
            height: 33.33%;
            width: 100%;
            transition: 0.45s cubic-bezier(.2, .8, .2, 1);
            pointer-events: none;
        }

            .active-bar::after {
                content: "";
                position: absolute;
                top: 50%;
                left: 0;
                transform: translateY(-50%);
                width: 4px;
                height: 46px;
                border-radius: 0 6px 6px 0;
                background: linear-gradient(180deg, #d9a6e3, #b06ab3);
                box-shadow: 0 0 18px rgba(217, 166, 227, 0.7);
            }

        /* Ortadaki kayan pano */
        .card-hero {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            margin: -20px 0;
            flex: 0 0 320px;
            border-radius: 26px;
            overflow: hidden;
            background: var(--brand-gradient);
            box-shadow: 0 24px 60px rgba(74, 21, 75, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.12);
            z-index: 3;
            color: #ffffff;
        }

            /* Pano üzerindeki dekoratif halkalar */
            .card-hero::before,
            .card-hero::after {
                content: "";
                position: absolute;
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, 0.12);
                pointer-events: none;
            }

            .card-hero::before {
                width: 340px;
                height: 340px;
                top: -150px;
                right: -150px;
            }

            .card-hero::after {
                width: 220px;
                height: 220px;
                bottom: -90px;
                left: -90px;
                background: radial-gradient(circle, rgba(217, 166, 227, 0.18), transparent 70%);
            }

        .card-hero-inner {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 200%;
            transition: 0.55s cubic-bezier(.2, .8, .2, 1);
        }

        .card-hero-content {
            height: 560px;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px 36px;
            box-sizing: border-box;
        }

            .card-hero-content .hero-brand {
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: rgba(255, 255, 255, 0.65);
                margin-bottom: 18px;
            }

            .card-hero-content h2 {
                font-size: 2rem;
                font-weight: 800;
                letter-spacing: -0.02em;
                line-height: 1.15;
                margin-bottom: 14px;
            }

            .card-hero-content h3 {
                font-size: 0.95rem;
                font-weight: 400;
                color: rgba(255, 255, 255, 0.78);
                line-height: 1.6;
            }

        /* Sağ taraf: formlar */
        .card-form {
            position: relative;
            overflow: hidden;
            padding: 20px 40px;
            flex: 1;
            display: flex;
            align-items: center;
        }

            .card-form .forms {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 200%;
                transition: 0.55s cubic-bezier(.2, .8, .2, 1);
            }

        .form-box {
            height: 520px;
            padding: 30px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-sizing: border-box;
        }

        .form-title-sub {
            font-size: 0.84rem;
            color: var(--color-muted);
            margin-bottom: 20px;
        }

            .form-title-sub a {
                color: var(--color-accent);
                text-decoration: none;
                font-weight: 700;
            }

                .form-title-sub a:hover {
                    text-decoration: underline;
                }

        .input-group-custom {
            margin-bottom: 14px;
        }

            .input-group-custom label {
                display: block;
                font-size: 0.78rem;
                font-weight: 600;
                color: var(--color-muted);
                margin-bottom: 6px;
            }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

            .input-wrapper input {
                width: 100%;
                padding: 12px 42px 12px 15px;
                border: 1px solid var(--color-border);
                border-radius: 14px;
                font-size: 0.9rem;
                background: rgba(255, 255, 255, 0.06);
                color: var(--color-text);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            }

                .input-wrapper input::placeholder {
                    color: var(--color-subtle);
                }

                .input-wrapper input:focus {
                    background: rgba(255, 255, 255, 0.09);
                    border-color: var(--color-accent);
                    box-shadow: 0 0 0 4px rgba(217, 166, 227, 0.15);
                }

                /* Tarayıcının kayıtlı şifre doldurduğunda verdiği açık zemini koyulaştırır */
                .input-wrapper input:-webkit-autofill {
                    -webkit-text-fill-color: var(--color-text);
                    -webkit-box-shadow: 0 0 0 40px #241829 inset;
                    caret-color: var(--color-text);
                }

            .input-wrapper i {
                position: absolute;
                right: 15px;
                color: var(--color-subtle);
                font-size: 0.9rem;
                pointer-events: none;
            }

            .input-wrapper input:focus + i {
                color: var(--color-accent);
            }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #8e3a92, #4a154b);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            cursor: pointer;
            margin-top: 10px;
            transition: transform 0.15s, box-shadow 0.2s, filter 0.2s;
            box-shadow: 0 10px 26px rgba(123, 45, 126, 0.45);
        }

            .btn-submit:hover {
                filter: brightness(1.1);
                transform: translateY(-1px);
                box-shadow: 0 14px 32px rgba(123, 45, 126, 0.55);
            }

            .btn-submit i {
                margin-left: 8px;
            }

            .btn-submit:disabled {
                filter: grayscale(0.3);
                opacity: 0.7;
                cursor: wait;
            }

        /* SweetAlert pencereleri de koyu */
        .swal2-popup {
            background: #241829 !important;
            color: var(--color-text) !important;
            border-radius: 24px !important;
            border: 1px solid var(--color-border);
        }

        .swal2-title { color: var(--color-text) !important; }
        .swal2-html-container { color: var(--color-muted) !important; }
        .swal2-styled.swal2-confirm { background: linear-gradient(135deg, #8e3a92, #4a154b) !important; border-radius: 12px !important; }

        /* Tablet / telefon: orta pano gizlenir, kart ekrana sığar */
        @@media (max-width: 820px) {
            .card-hero {
                display: none;
            }

            .card-nav {
                width: 84px;
            }

                .card-nav button span {
                    font-size: 0.72rem;
                }

            .card-form {
                padding: 10px 6px;
            }

            .form-box {
                padding: 24px 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .card { animation: none; }
        }
    </style>
</head>
<body>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>

    <div class="card">
        <!-- DÜZELTME: .active-bar div'i ul etiketinin dışına çıkarıldı -->
        <ul class="card-nav">
            <li>
                <span class="nav-logo" title="LezzetPOS"><i class="fa-solid fa-utensils"></i></span>
            </li>
            <li>
                <button type="button" class="signin active" onclick="selectView('signin')">
                    <i class="fa-solid fa-user-check"></i>
                    <span>Giriş Yap</span>
                </button>
            </li>
            <li>
                <button type="button" class="signup" onclick="selectView('signup')">
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Kayıt Ol</span>
                </button>
            </li>
        </ul>
        <div class="active-bar"></div>

        <!-- Ortadaki Banner -->
        <div class="card-hero">
            <div class="card-hero-inner">
                <div class="card-hero-content signin">
                    <div class="hero-brand">LezzetPOS</div>
                    <h2>Tekrar Hoş Geldiniz!</h2>
                    <h3>Sisteme erişmek için bilgilerinizi giriniz.</h3>
                </div>
                <div class="card-hero-content signup">
                    <div class="hero-brand">LezzetPOS</div>
                    <h2>Aramıza Katılın.</h2>
                    <h3>Restoranınızı hemen yönetmeye başlamak için kaydolun.</h3>
                </div>
            </div>
        </div>

        <!-- Sağ Taraf: Formlar -->
        <div class="card-form">
            <div class="forms">
                <!-- 1. GİRİŞ YAP FORMU -->
                <div class="form-box">
                    <p class="form-title-sub">Hesabınız yok mu? <a href="#" onclick="selectView('signup')">Kayıt Ol</a></p>

                    <form id="formSignIn">
                        <div class="input-group-custom">
                            <label>E-Posta Adresi</label>
                            <div class="input-wrapper">
                                <input type="email" id="loginEmail" placeholder="ornek@lezzetpos.com" required />
                                <i class="fa-regular fa-envelope"></i>
                            </div>
                        </div>

                        <div class="input-group-custom">
                            <label>Şifre</label>
                            <div class="input-wrapper">
                                <input type="password" id="loginPassword" placeholder="••••••••" required />
                                <i class="fa-solid fa-lock"></i>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit" id="btnSignInSubmit">
                            Giriş Yap <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </form>
                </div>

                <!-- 2. KAYIT OL FORMU -->
                <div class="form-box">
                    <p class="form-title-sub">Zaten hesabınız var mı? <a href="#" onclick="selectView('signin')">Giriş Yap</a></p>

                    <form id="formSignUp">
                        <div class="input-group-custom">
                            <label>Ad Soyad</label>
                            <div class="input-wrapper">
                                <input type="text" id="regFullName" placeholder="Ahmet Yılmaz" required />
                                <i class="fa-solid fa-user"></i>
                            </div>
                        </div>

                        <div class="input-group-custom">
                            <label>Restoran / Şirket Adı</label>
                            <div class="input-wrapper">
                                <input type="text" id="regCompanyName" placeholder="Lezzet Restoran" required />
                                <i class="fa-solid fa-building"></i>
                            </div>
                        </div>

                        <div class="input-group-custom">
                            <label>E-Posta Adresi</label>
                            <div class="input-wrapper">
                                <input type="email" id="regEmail" placeholder="ornek@lezzetpos.com" required />
                                <i class="fa-regular fa-envelope"></i>
                            </div>
                        </div>

                        <div class="input-group-custom">
                            <label>Şifre</label>
                            <div class="input-wrapper">
                                <input type="password" id="regPassword" placeholder="••••••••" required />
                                <i class="fa-solid fa-lock"></i>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit" id="btnSignUpSubmit">
                            Kayıt Ol <i class="fa-solid fa-user-check ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Görünüm Değiştirme Animasyonu
        const navButtons = document.querySelectorAll(".card-nav button"),
            cardForms = document.querySelector(".card-form .forms"),
            activeBar = document.querySelector(".active-bar"),
            cardHeroInner = document.querySelector(".card-hero-inner");

        const selectView = (view) => {
            for (let button of navButtons) {
                button.classList.remove("active");
                if (button.classList.contains(view)) {
                    button.classList.add("active");
                }
            }

            if (view === "signin") {
                cardForms.style.top = "0";
                activeBar.style.top = "33.33%";
                cardHeroInner.style.top = "0";
            } else {
                cardForms.style.top = "-100%";
                activeBar.style.top = "66.66%";
                cardHeroInner.style.top = "-100%";
            }
        };

        $(document).ready(function () {
            // GİRİŞ YAP AJAX (Siz istediğiniz gibi SweetAlert "Giriş Başarılı" POPUP'I KALDIRILDI)
            $("#formSignIn").on("submit", function (e) {
                e.preventDefault();

                var email = $("#loginEmail").val().trim();
                var password = $("#loginPassword").val().trim();

                var $btn = $("#btnSignInSubmit");
                $btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Giriş Yapılıyor...');

                $.ajax({
                    url: "/Auth/ApiLogin",
                    type: "POST",
                    data: {
                        Username: email,
                        Password: password
                    },
                    success: function (response) {
                        if (response.success) {
                            // Önceki kullanıcıdan kalan bilgiler temizlenir; sayfa JS'leri token'ı Authorization başlığında gönderir
                            localStorage.removeItem("JWToken");
                            localStorage.setItem("JWToken", response.token);
                            localStorage.setItem("Username", response.username || "");
                            localStorage.setItem("FullName", response.fullName || "");
                            localStorage.setItem("Role", response.role || "");

                            // DİREKT YÖNLENDİRME (Pop-up yok)
                            window.location.href = response.redirectUrl;
                        } else {
                            $btn.prop("disabled", false).html('Giriş Yap <i class="fa-solid fa-arrow-right ms-1"></i>');
                            Swal.fire("Giriş Başarısız", response.message || "Hatalı e-posta veya şifre.", "error");
                        }
                    },
                    error: function () {
                        $btn.prop("disabled", false).html('Giriş Yap <i class="fa-solid fa-arrow-right ms-1"></i>');
                        Swal.fire("Hata", "Sunucuya bağlanırken bir sorun oluştu.", "error");
                    }
                });
            });

            // KAYIT OL AJAX
            $("#formSignUp").on("submit", function (e) {
                e.preventDefault();

                var fullName = $("#regFullName").val().trim();
                var companyName = $("#regCompanyName").val().trim();
                var email = $("#regEmail").val().trim();
                var password = $("#regPassword").val().trim();

                var $btn = $("#btnSignUpSubmit");
                $btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Kaydediliyor...');

                $.ajax({
                    url: "/Auth/ApiRegister",
                    type: "POST",
                    data: {
                        FullName: fullName,
                        CompanyName: companyName,
                        Username: email,
                        Email: email,
                        Password: password
                    },
                    success: function (response) {
                        $btn.prop("disabled", false).html('Kayıt Ol <i class="fa-solid fa-user-check ms-1"></i>');

                        if (response.success) {
                            $("#formSignUp")[0].reset();
                            selectView('signin');
                        } else {
                            Swal.fire("Kayıt Başarısız", response.message, "error");
                        }
                    },
                    error: function () {
                        $btn.prop("disabled", false).html('Kayıt Ol <i class="fa-solid fa-user-check ms-1"></i>');
                        Swal.fire("Hata", "Sunucuya bağlanırken bir sorun oluştu.", "error");
                    }
                });
            });
        });
    </script>
</body>
</html>